# Copy to .env and fill locally. Never commit the real file.
ORCHESTRATOR_BASE_URL=http://127.0.0.1:20128
ORCHESTRATOR_MODEL=example-model

# Exact model mappings. Use a local test key or inject these through a secret manager.
LLM_KEY_1=replace-me
LLM_KEY_1_MODELS=example-model

# Optional wildcard fallback:
# LLM_KEY_2=replace-me
# LLM_KEY_2_MODELS=*
